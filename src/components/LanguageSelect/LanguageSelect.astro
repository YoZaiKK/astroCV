---
import { Languages, ChevronDown, Check } from '@lucide/astro';
import { t, type Locale } from '../../i18n';
import './styles.css';

interface Props {
	locale: Locale;
}

const { locale } = Astro.props;
const id = `language-${crypto.randomUUID()}`;
const options = [
	{ value: 'en', label: 'English', href: '/' },
	{ value: 'es', label: 'Espanol', href: '/es/' },
];
---

<language-picker class="language-picker" data-locale={locale}>
	<div
		class="language-trigger"
		role="combobox"
		tabindex="0"
		aria-label={t('preferences.languageLabel')}
		aria-haspopup="listbox"
		aria-controls={`${id}-options`}
		aria-expanded="false"
	>
		<Languages size={18} aria-hidden="true" />
		<span data-language-value>{options.find(option => option.value === locale)!.label}</span>
		<ChevronDown class="language-chevron" size={16} aria-hidden="true" />
	</div>
	<div id={`${id}-options`} class="language-panel" role="listbox" aria-label={t('preferences.languageLabel')} hidden>
		{options.map(option => (
			<div
				id={`${id}-${option.value}`}
				class="language-option"
				role="option"
				aria-selected={option.value === locale ? 'true' : 'false'}
				data-locale={option.value}
				data-href={option.href}
			>
				<span>{option.label}</span>
				<Check size={16} aria-hidden="true" />
			</div>
		))}
	</div>
</language-picker>

<noscript>
	<div class="language-fallback" aria-label={t('preferences.languageLabel')}>
		{options.map(option => <a href={option.href} lang={option.value}>{option.label}</a>)}
	</div>
</noscript>

<script>
	import { LanguagePicker } from './controller';
	if (!customElements.get('language-picker')) customElements.define('language-picker', LanguagePicker);
</script>
