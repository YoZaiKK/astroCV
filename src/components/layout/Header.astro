---
import { Sun, Moon } from '@lucide/astro';
import LanguageSelect from '../LanguageSelect/LanguageSelect.astro';
import { resumePath } from '../../data/content';
import { type Locale, t } from '../../i18n';

interface Props {
	name: string;
	locale: Locale;
}

const { name, locale } = Astro.props;
const links = [
	['about', t('navigation.about')],
	['experience', t('navigation.experience')],
	['projects', t('navigation.projects')],
	['skills', t('navigation.skills')],
	['education', t('navigation.education')],
	['contact', t('navigation.contact')],
];
---

<header class="site-header">
	<div class="container header-content">
		<a class="brand" href="#main-content" aria-label={`${name} — ${t('navigation.home')}`}>{name}</a>
		<button class="menu-button" type="button" aria-expanded="false" aria-controls="primary-navigation">
			<span class="menu-icon" aria-hidden="true"></span>
			<span class="sr-only">{t('navigation.openMenu')}</span>
		</button>
		<nav id="primary-navigation" aria-label={t('navigation.primaryLabel')}>
			<ul>
				{links.map(([id, label]) => <li><a href={`#${id}`}>{label}</a></li>)}
			</ul>
			<div class="header-actions">
				<LanguageSelect locale={locale} />
				<div class="theme-controls">
					<button
						class="theme-toggle"
						type="button"
						data-theme-toggle
						role="switch"
						aria-checked="false"
						aria-label={t('preferences.themeLabel')}
						disabled
					>
						<span class="theme-switch-track" aria-hidden="true">
							<Sun class="icon-sun" size={16} />
							<Moon class="icon-moon" size={16} />
							<span class="theme-switch-thumb"></span>
						</span>
					</button>
					<label class="theme-auto">
						<input type="checkbox" data-theme-auto aria-label={`${t('preferences.auto')}: ${t('preferences.system')}`} disabled />
						<span>{t('preferences.auto')}</span>
					</label>
				</div>
				<a class="button button-small" href={resumePath} download>{t('common.downloadResume')}</a>
			</div>
		</nav>
	</div>
</header>

<script>
	import { resolveTheme, toggleTheme, type Theme, type ThemeMode } from './theme';
	const button = document.querySelector<HTMLButtonElement>('.menu-button');
	const navigation = document.querySelector<HTMLElement>('#primary-navigation');
	const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
	const themeAuto = document.querySelector<HTMLInputElement>('[data-theme-auto]');
	const root = document.documentElement;
	const systemTheme = window.matchMedia('(prefers-color-scheme: dark)');
	let mode = root.dataset.themeMode as ThemeMode;

	const applyTheme = (theme: 'light' | 'dark') => {
		root.dataset.theme = theme;
		root.dataset.themeMode = mode;
		if (themeAuto) { themeAuto.checked = mode === 'system'; themeAuto.disabled = false; }
		if (themeToggle) themeToggle.disabled = false;
		themeToggle?.setAttribute('aria-checked', String(theme === 'dark'));
	};

	const saveMode = () => {
		try { localStorage.setItem('theme', mode); } catch { /* In-memory controls still work. */ }
	};

	button?.addEventListener('click', () => {
		const open = button.getAttribute('aria-expanded') === 'true';
		button.setAttribute('aria-expanded', String(!open));
		navigation?.classList.toggle('is-open', !open);
	});

	navigation?.querySelectorAll('a').forEach((link) => {
		link.addEventListener('click', () => {
			button?.setAttribute('aria-expanded', 'false');
			navigation?.classList.remove('is-open');
		});
	});

	const initialTheme = root.dataset.theme === 'dark' ? 'dark' : 'light';
	applyTheme(initialTheme);
	systemTheme.addEventListener('change', (event) => {
		if (mode === 'system') applyTheme(event.matches ? 'dark' : 'light');
	});

	themeToggle?.addEventListener('click', () => {
		const next = toggleTheme(root.dataset.theme as Theme);
		mode = next.mode;
		applyTheme(next.theme);
		saveMode();
	});

	themeAuto?.addEventListener('change', () => {
		mode = themeAuto.checked ? 'system' : root.dataset.theme as Theme;
		applyTheme(resolveTheme(mode, systemTheme.matches).theme);
		saveMode();
	});

</script>
