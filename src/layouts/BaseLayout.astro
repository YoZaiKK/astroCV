---
import '../styles/global.css';
import Footer from '../components/layout/Footer.astro';
import Header from '../components/layout/Header.astro';
import { portfolio } from '../data/content';
import { getLocale, type Locale, t } from '../i18n';
import { themeBootstrap } from '../components/layout/theme';

interface Props {
	title?: string;
	description?: string;
	locale?: Locale;
}

const {
	title = t('meta.homeTitle', { name: portfolio.profile.name }),
	description = t('meta.homeDescription'),
	locale = getLocale(),
} = Astro.props;
---

<!doctype html>
<html lang={locale}>
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width" />
		<meta name="description" content={description} />
		<script is:inline set:html={themeBootstrap} />
		<title>{title}</title>
	</head>
	<body>
		<a class="skip-link" href="#main-content">{t('accessibility.skipToContent')}</a>
		<Header name={portfolio.profile.name} locale={locale} />
		<slot />
		<Footer name={portfolio.profile.name} githubUrl={portfolio.profile.githubUrl} />
	</body>
</html>
